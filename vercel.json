{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/static/:path*", "destination": "/site/studio/static/:path*" },
    { "source": "/studio", "destination": "/site/studio/index" },
    { "source": "/studio/:path*", "destination": "/site/studio/index" },
    { "source": "/", "destination": "/site" },
    { "source": "/:path*", "destination": "/site/:path*" }
  ]
}
